digraph "fldot" {
  graph [rankdir=LR, bgcolor="#1f1f1f", fontname="Arial", fontcolor="#ffffff", label="fldot", labelloc=t, fontsize=24, pad=0.6, nodesep=1.25, ranksep=1.75, splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="#111111", color="#2c2c2c", fontname="Arial", fontcolor="#ffffff", fontsize=12, margin="0.16,0.10"];
  edge [arrowsize=0.65, penwidth=1.2];
"flow:entry" [label="flow.link\nentry", shape=oval, fillcolor="#111111", color="#ff4500", penwidth=2.2];
"node:handle_api" [label="handle_api"];
"node:auth_guard" [label="auth_guard"];
"node:run_query" [label="run_query"];
"node:handle_web" [label="handle_web"];
"node:session_mgr" [label="session_mgr"];
"node:render_page" [label="render_page"];
"node:db_pool" [label="db_pool"];
"node:template_engine" [label="template_engine"];
"file:views/home.flow" [label="child flow\\nviews/home.flow", shape=folder, fillcolor="#242424", color="#ff6a00", penwidth=1.8];
"flow:entry" -> "node:handle_api" [style=dashed, color="#ff8a00", penwidth=1.35];
"flow:entry" -> "node:handle_web" [style=dashed, color="#ff8a00", penwidth=1.35];
"node:handle_api" -> "node:auth_guard" [style=dashed, color="#bdbdbd", penwidth=1.35];
"node:handle_api" -> "node:run_query" [color="#f5f5f5", penwidth=1.8];
"node:handle_web" -> "node:session_mgr" [style=dashed, color="#bdbdbd", penwidth=1.35];
"node:handle_web" -> "node:render_page" [color="#f5f5f5", penwidth=1.8];
"node:run_query" -> "node:db_pool" [style=dashed, color="#bdbdbd", penwidth=1.35];
"node:render_page" -> "file:views/home.flow" [style=dotted, color="#ff6a00", penwidth=1.8];
"node:render_page" -> "node:template_engine" [style=dashed, color="#bdbdbd", penwidth=1.35];
}
